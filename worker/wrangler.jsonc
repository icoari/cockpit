{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bob",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,

  // Smart Placement: run the Worker close to the backends it calls most
  // (LLM endpoints, IDFM, Workers AI) rather than at the edge nearest the
  // caller, when that measurably lowers request duration.
  "placement": { "mode": "smart" },

  // CPU time, not wall time: waiting on Whisper, the LLM upstream or KV costs
  // nothing here. The headroom covers parsing large /transcribe bodies (up to
  // 25 MB of base64 audio) and the feed XML parsing in the cron.
  "limits": { "cpu_ms": 30000 },

  "observability": { "enabled": true },

  "kv_namespaces": [
    { "binding": "KV", "id": "317a9f34cb9d4c1fb377e116cbb8cbed" }
  ],

  // Workers AI — Whisper (speech-to-text), used by /transcribe.
  "ai": { "binding": "AI" },

  // Failed authentications and /sync/setup calls, per client IP and per
  // Cloudflare location (period must be 10 or 60 s).
  "ratelimits": [
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],

  "vars": {
    "VAPID_PUBLIC_KEY": "BFAFeTqjyY9y1FTcPcWtFHfARz4hUkXCBa9iqFePsaX0MhCiHTsXlazm65CbqIbL2EBl5qRw_tRMzdueTwsXd9o",
    "VAPID_SUBJECT": "mailto:bob@icoari.dev"
  },
  // Secrets (wrangler secret put <NAME>):
  //   VAPID_PRIVATE_KEY      Web Push signing key
  //   GOOGLE_CLIENT_SECRET   Google Calendar refresh flow

  "triggers": {
    "crons": [
      "*/10 * * * *",     // feed aggregation
      "*/15 4-23 * * *",  // IDFM disruption watch
      "0 5 * * *",        // morning brief push (7h Paris summer / 6h winter)
      "0 16 * * *"        // last-train-of-tonight check (18h Paris summer / 17h winter)
    ]
  }
}
